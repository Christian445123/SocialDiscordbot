# Kopiere diese Datei zu .env und fülle die Werte aus
DISCORD_TOKEN=your-discord-bot-token
CLIENT_ID=your-bot-application-client-id
# Optional: Wenn du die Commands nur in einer Guild zum Testen registrieren willst, setze GUILD_ID
GUILD_ID=your-test-guild-id
CHANNEL_ID=the-channel-id-to-post-updates

# Plattform-Benutzernamen (ohne @)
TIKTOK_USERNAME=the_tiktok_username_without_at
INSTAGRAM_USERNAME=the_instagram_username_without_at

# Optional: Konfiguriere Cron-Interval (Cron expression). Standard ist alle 4 Stunden -> "0 */4 * * *"
CRON_SCHEDULE=0 */4 * * *